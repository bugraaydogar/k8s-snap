@@ -0,0 +1,32 @@
+package snap_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/canonical/k8sd/pkg/snap"
+)
+
+func TestCNIBinDirVisibleOnHost(t *testing.T) {
+	for _, confinement := range []string{"classic", "strict"} {
+		t.Run(confinement, func(t *testing.T) {
+			snapDir := t.TempDir()
+			if err := os.Mkdir(filepath.Join(snapDir, "meta"), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(snapDir, "meta", "snap.yaml"), []byte("confinement: "+confinement+"\n"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			commonDir := filepath.Join(t.TempDir(), "common")
+			s := snap.NewSnap(snap.SnapOpts{SnapDir: snapDir, SnapCommonDir: commonDir})
+			want := "/opt/cni/bin"
+			if confinement == "strict" {
+				want = filepath.Join(commonDir, "opt", "cni", "bin")
+			}
+			if got := s.CNIBinDir(); got != want {
+				t.Fatalf("CNIBinDir() = %q, want host-visible path %q", got, want)
+			}
+		})
+	}
+}
diff --git a/pkg/snap/snap.go b/pkg/snap/snap.go
index 4f506d4..8674ebf 100644
--- a/pkg/snap/snap.go
+++ b/pkg/snap/snap.go
@@ -254,6 +254,11 @@ func (s *snap) CNIConfDir() string {
 }
 
 func (s *snap) CNIBinDir() string {
+	if s.Strict() {
+		// Cilium also executes CNI helpers in the host mount namespace, where
+		// the snap's /opt/cni/bin layout is not visible.
+		return filepath.Join(s.snapCommonDir, "opt", "cni", "bin")
+	}
 	return "/opt/cni/bin"
 }
 
