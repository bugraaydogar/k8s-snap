+package cilium_test
+
+import (
+	"context"
+	"errors"
+	"net/url"
+	"testing"
+
+	helmmock "github.com/canonical/k8sd/pkg/client/helm/mock"
+	"github.com/canonical/k8sd/pkg/k8sd/features/cilium"
+	"github.com/canonical/k8sd/pkg/k8sd/types"
+	snapmock "github.com/canonical/k8sd/pkg/snap/mock"
+	"github.com/canonical/k8sd/pkg/utils"
+	mctypes "github.com/canonical/microcluster/v3/microcluster/types"
+	"k8s.io/utils/ptr"
+)
+
+type cniPathState struct{ mctypes.State }
+
+func (cniPathState) Address() *url.URL { return &url.URL{Host: "127.0.0.1:6400"} }
+
+func TestNetworkUsesSnapCNIBinDir(t *testing.T) {
+	oldMountPath, oldPropagation := cilium.GetMountPath, cilium.GetMountPropagationType
+	t.Cleanup(func() {
+		cilium.GetMountPath, cilium.GetMountPropagationType = oldMountPath, oldPropagation
+	})
+	cilium.GetMountPath = func(fs string) (string, error) { return "/sys/fs/" + fs, nil }
+	cilium.GetMountPropagationType = func(string) (utils.MountPropagationType, error) {
+		return utils.MountPropagationShared, nil
+	}
+	for _, test := range []struct {
+		name, binDir string
+		strict       bool
+	}{
+		{name: "classic", binDir: "/opt/cni/bin"},
+		{name: "strict", binDir: "/var/snap/k8s/common/opt/cni/bin", strict: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			stopAfterApply := errors.New("stop after recording chart values")
+			helm := &helmmock.Mock{ApplyErr: stopAfterApply}
+			s := &snapmock.Snap{Mock: snapmock.Mock{
+				HelmClient: helm, Strict: test.strict, CNIBinDir: test.binDir,
+			}}
+			_, err := cilium.ApplyNetwork(context.Background(), s, cniPathState{},
+				types.APIServer{SecurePort: ptr.To(6443)},
+				types.Network{Enabled: ptr.To(true), PodCIDR: ptr.To("10.1.0.0/16")}, nil)
+			if !errors.Is(err, stopAfterApply) || len(helm.ApplyCalledWith) != 1 {
+				t.Fatalf("expected chart application; calls=%d, err=%v", len(helm.ApplyCalledWith), err)
+			}
+			values := helm.ApplyCalledWith[0].Values
+			if got := values["cni"].(map[string]any)["binPath"]; got != test.binDir {
+				t.Fatalf("Cilium binPath = %q, want snap CNI directory %q", got, test.binDir)
+			}
+		})
+	}
+}
