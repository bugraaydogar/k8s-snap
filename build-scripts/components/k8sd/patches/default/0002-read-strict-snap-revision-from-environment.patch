+package snap_test
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/canonical/k8sd/pkg/snap"
+	. "github.com/onsi/gomega"
+)
+
+func TestStrictRevisionDoesNotUseSnapd(t *testing.T) {
+	g := NewWithT(t)
+	dir := t.TempDir()
+	g.Expect(os.Mkdir(filepath.Join(dir, "meta"), 0o755)).To(Succeed())
+	g.Expect(os.WriteFile(filepath.Join(dir, "meta", "snap.yaml"), []byte("confinement: strict\n"), 0o644)).To(Succeed())
+	original := http.DefaultTransport
+	http.DefaultTransport = nil
+	t.Cleanup(func() { http.DefaultTransport = original })
+	for _, revision := range []string{"123", "x1", ""} {
+		t.Run("revision="+revision, func(t *testing.T) {
+			g := NewWithT(t)
+			s := snap.NewSnap(snap.SnapOpts{SnapDir: dir, SnapRevision: revision})
+			got, err := s.Revision(context.Background())
+			if revision == "" {
+				g.Expect(err).To(MatchError("failed to get snap revision: SNAP_REVISION is empty"))
+			} else {
+				g.Expect(err).ToNot(HaveOccurred())
+				g.Expect(got).To(Equal(revision))
+			}
+		})
+	}
+}
+
+func TestClassicRevisionUsesSnapd(t *testing.T) {
+	cases := map[string]struct{ response, revision, errorText string }{
+		"k8s":       {`{"status-code":200,"result":{"revision":"456"}}`, "456", ""},
+		"missing":   {`{"status-code":404}`, "", "snapd returned with error code 404"},
+		"empty":     {`{"status-code":200}`, "", "got empty string"},
+		"malformed": {`{`, "", "could not unmarshal response body"},
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		tc, ok := cases[strings.TrimPrefix(r.URL.Path, "/v2/snaps/")]
+		if !ok || !strings.HasPrefix(r.URL.Path, "/v2/snaps/") {
+			t.Errorf("unexpected snapd path %q", r.URL.Path)
+		}
+		fmt.Fprint(w, tc.response)
+	}))
+	defer server.Close()
+	original := http.DefaultTransport
+	transport := original.(*http.Transport).Clone()
+	transport.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", strings.TrimPrefix(server.URL, "http://"))
+	}
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = original; transport.CloseIdleConnections() })
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			g := NewWithT(t)
+			s := snap.NewSnap(snap.SnapOpts{SnapInstanceName: name, SnapRevision: "123"})
+			got, err := s.Revision(context.Background())
+			g.Expect(got).To(Equal(tc.revision))
+			if tc.errorText == "" {
+				g.Expect(err).ToNot(HaveOccurred())
+			} else {
+				g.Expect(err).To(MatchError(ContainSubstring(tc.errorText)))
+			}
+		})
+	}
+	http.DefaultTransport = nil
+	s := snap.NewSnap(snap.SnapOpts{})
+	_, err := s.Revision(context.Background())
+	NewWithT(t).Expect(err).To(MatchError(ContainSubstring("failed to create snapd client")))
+}
