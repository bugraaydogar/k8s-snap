From: K8s builder bot <k8s-bot@canonical.com>
Subject: [PATCH] use snapctl for strict service lifecycle

Strict snaps should manage their own services through snapctl rather
than by shelling out to the host snap command. Keep the existing snap
command path for classic confinement, but switch strict confinement to
snapctl start, stop, and restart.

The k8sd pre-remove path is the only current service lifecycle caller
that passes --no-wait. snapctl service commands do not support that snap
CLI flag, so strict pre-remove stops services synchronously and logs
that decision.
---
 pkg/k8sd/app/hooks_remove.go |   7 ++-
 pkg/snap/snap.go             |   7 ++-
 pkg/snap/snap_test.go        | 100 ++++++++++++++++++++++++++++++-----
 3 files changed, 98 insertions(+), 16 deletions(-)

diff --git a/pkg/k8sd/app/hooks_remove.go b/pkg/k8sd/app/hooks_remove.go
index c593a86..7764e34 100644
--- a/pkg/k8sd/app/hooks_remove.go
+++ b/pkg/k8sd/app/hooks_remove.go
@@ -92,7 +92,12 @@ func (a *App) onPreRemove(ctx context.Context, s mctypes.State, force bool) (rer
 			cleanup.SyncISCSIDevices(ctx)
 
 			log.Info("Stopping all services except k8sd")
-			if err := snaputil.StopK8sServices(ctx, snap, "--no-wait"); err != nil {
+			stopArgs := []string{"--no-wait"}
+			if snap.Strict() {
+				log.Info("Strict confinement uses snapctl service control, stopping services synchronously")
+				stopArgs = nil
+			}
+			if err := snaputil.StopK8sServices(ctx, snap, stopArgs...); err != nil {
 				log.Error(err, "failed to stop k8s services")
 			}
 
diff --git a/pkg/snap/snap.go b/pkg/snap/snap.go
index a0a778b..4f506d4 100644
--- a/pkg/snap/snap.go
+++ b/pkg/snap/snap.go
@@ -76,7 +76,12 @@ func NewSnap(opts SnapOpts) *snap {
 
 // buildServiceCommand creates a snap command for managing services.
 func (s *snap) buildServiceCommand(action string, names []string, extraSnapArgs ...string) []string {
-	cmd := []string{"snap", action}
+	command := "snap"
+	if s.Strict() {
+		command = "snapctl"
+	}
+
+	cmd := []string{command, action}
 	for _, name := range names {
 		cmd = append(cmd, serviceName(name))
 	}
