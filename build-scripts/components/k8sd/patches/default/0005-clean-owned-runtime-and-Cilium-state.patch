+	target := filepath.Join(unrelated, "keep")
+	if err := os.WriteFile(target, []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(unrelated, filepath.Join(root, "external")); err != nil {
+		t.Fatal(err)
+	}
+	if err := removeCiliumDirectory(root, nil); err != nil {
+		t.Fatal(err)
