index 0000000..092086e
--- /dev/null
+++ b/pkg/k8sd/features/cilium/cleanup_directories.go
@@ -0,0 +1,94 @@
+package cilium
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/moby/sys/mountinfo"
+)
+
+func removeCiliumDirectories(paths []string, readMounts func(mountinfo.FilterFunc) ([]*mountinfo.Info, error)) error {
+	mounts, err := readMounts(nil)
+	if err != nil {
+		return fmt.Errorf("read mounts before removing Cilium directories: %w", err)
+	}
+	var errs []error
+	for _, path := range paths {
+		if err := removeCiliumDirectory(path, mounts); err != nil {
+			errs = append(errs, fmt.Errorf("remove Cilium directory %s: %w", path, err))
+		}
+	}
+	return errors.Join(errs...)
+}
+
+func removeCiliumDirectory(path string, mounts []*mountinfo.Info) error {
+	info, err := os.Lstat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("refusing non-directory or symlink root")
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil {
+		return err
+	}
+	// All owned containers are stopped before this cleanup. Refuse existing
+	// mount boundaries rather than recursively deleting another filesystem.
+	for _, mount := range mounts {
+		mounted := filepath.Clean(mount.Mountpoint)
+		if mounted == path || strings.HasPrefix(mounted, path+string(filepath.Separator)) ||
+			mounted == resolved || strings.HasPrefix(mounted, resolved+string(filepath.Separator)) {
+			return fmt.Errorf("refusing mounted Cilium state at %s", mounted)
+		}
+	}
+	root, err := os.OpenRoot(path)
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+	opened, err := root.Stat(".")
+	if err != nil {
+		return err
+	}
+	if !os.SameFile(info, opened) {
+		return fmt.Errorf("Cilium directory changed before cleanup")
+	}
+	if err := removeCiliumDirectoryContents(root); err != nil {
+		return err
+	}
+	current, err := os.Lstat(path)
+	if err != nil {
+		return err
+	}
+	if !os.SameFile(info, current) {
+		return fmt.Errorf("Cilium directory changed during cleanup")
+	}
+	// RemoveAll(path) opens the parent directory, which strict confinement need
+	// not allow. The contents are gone, so Remove only needs the owned path.
+	return os.Remove(path)
+}
+
+func removeCiliumDirectoryContents(root *os.Root) error {
+	dir, err := root.Open(".")
+	if err != nil {
+		return err
+	}
+	entries, readErr := dir.ReadDir(-1)
+	if err := errors.Join(readErr, dir.Close()); err != nil {
+		return err
+	}
+	var errs []error
+	for _, entry := range entries {
+		if err := root.RemoveAll(entry.Name()); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
