--- /dev/null
+++ b/pkg/utils/shims/shims_test.go
@@ -0,0 +1,59 @@
+package shims
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestCleanupReadsExecutableInsteadOfTrustingProcessArguments(t *testing.T) {
+	dir := t.TempDir()
+	// The current test binary cannot become a snap shim by spoofing argv[0].
+	output := fmt.Sprintf("invalid\n%d 1 /snap/k8s/42/bin/containerd-shim-runc-v2 -namespace k8s.io\n2147483647 1 /snap/k8s/42/bin/containerd-shim-runc-v2\n99 1 unrelated\n", os.Getpid())
+	ps := "#!/bin/sh\nprintf '%s' '" + output + "'\n"
+	if err := os.WriteFile(filepath.Join(dir, "ps"), []byte(ps), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+":"+os.Getenv("PATH"))
+	procs, err := listAllSystemProcesses(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if procs[fmt.Sprint(os.Getpid())].executable == "" {
+		t.Fatal("did not read executable identity")
+	}
+	pids, err := RunningContainerdShimPIDs(context.Background())
+	if err != nil || len(pids) != 0 {
+		t.Fatalf("selected spoofed/exited shims: %v err=%v", pids, err)
+	}
+}
+
+func TestCleanupReportsProcessEnumerationFailure(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "ps"), []byte("#!/bin/sh\nexit 19\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+":"+os.Getenv("PATH"))
+	if _, err := RunningContainerdShimPIDs(context.Background()); err == nil {
+		t.Fatal("process enumeration failure was ignored")
+	}
+}
+
+func TestCleanupSelectsOnlySnapShimDescendants(t *testing.T) {
+	procs := map[string]processInfo{
+		"10": {command: "/snap/k8s/42/bin/containerd-shim-runc-v2 -namespace k8s.io", executable: "/snap/k8s/42/bin/containerd-shim-runc-v2", parentPID: "1"},
+		"11": {command: "/pause", parentPID: "10"},
+		"12": {command: "workload", parentPID: "11"},
+		"20": {command: "/pause", parentPID: "1"},
+		"21": {command: "/snap/other/42/bin/containerd-shim-runc-v2", parentPID: "1"},
+		"22": {command: "/snap/k8s/42/bin/containerd-shim-runc-v2-other", parentPID: "1"},
+		"23": {command: "/snap/k8s/42/bin/containerd-shim-runc-v2", executable: "/usr/bin/sleep", parentPID: "1"},
+	}
+	got := findAllChildren(findShimPIDs(procs), makeShallowChildPIDs(procs))
+	if want := []string{"12", "11", "10"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("cleanup PIDs = %v, want children before owned shim %v", got, want)
+	}
+}
