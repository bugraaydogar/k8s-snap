+func cleanupCiliumStateWith(ctx context.Context, snap snap.Snap, statHelper func(string) (os.FileInfo, error), runCleanup func(context.Context, string, string) error, removeDirectories func() error) error {
+	helper := filepath.Join(snap.CNIBinDir(), "cilium-dbg")
