+	if err := os.RemoveAll(root); !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("RemoveAll should reproduce denied parent read: %v", err)
+	}
+	if err := removeCiliumDirectory(root, nil); err != nil {
+		t.Fatal(err)
