+func runCiliumCleanup(ctx context.Context, helper, pidFile string) error {
+	if err := os.Remove(pidFile); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("remove stopped Cilium PID file: %w", err)
+	}
+	cmd := exec.CommandContext(ctx, helper, "post-uninstall-cleanup", "--all-state", "--force")
+	// Go's default cancellation uses pidfd_send_signal, unavailable in older
+	// strict seccomp policies. This PID is our own unreaped child.
+	cmd.Cancel = func() error {
+		if err := syscall.Kill(cmd.Process.Pid, syscall.SIGKILL); err != nil {
+			if errors.Is(err, syscall.ESRCH) {
+				return os.ErrProcessDone
+			}
+			return err
+		}
+		return nil
+	}
+	cmd.WaitDelay = time.Second
+	// Cilium reports individual cleanup failures on stderr even when it exits
+	// successfully. Preserve diagnostics; residual-state tests verify teardown.
+	cmd.Stdout, cmd.Stderr = os.Stdout, os.Stderr
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("cilium-dbg cleanup failed: %w", err)
+	}
 	return nil
