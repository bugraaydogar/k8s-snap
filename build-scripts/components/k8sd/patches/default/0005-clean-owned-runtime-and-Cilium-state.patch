+func TestKillContainerProcessesHonorsDeadline(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err := killContainerProcesses(ctx, []containerProcess{{42, "1"}}, func(int, unix.Signal) error { return nil }, func(int) (string, error) { return "1", nil })
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("want cancellation, got %v", err)
+	}
+}
+
+func TestKillContainerProcessesDoesNotSignalReusedPID(t *testing.T) {
+	err := killContainerProcesses(context.Background(), []containerProcess{{42, "1"}}, func(int, unix.Signal) error { t.Fatal("signaled reused PID"); return nil }, func(int) (string, error) { return "2", nil })
+	if err != nil {
+		t.Fatal(err)
