+func containerNetworkNamespaces(pids []string, procDir, netnsDir string) (map[string]bool, error) {
+	owned := make(map[string]bool)
+	var namespaces []os.FileInfo
+	var errs []error
+	for _, pid := range pids {
+		info, err := os.Stat(filepath.Join(procDir, pid, "ns", "net"))
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			errs = append(errs, err)
 			continue
 		}
+		namespaces = append(namespaces, info)
+	}
+	entries, err := os.ReadDir(netnsDir)
+	if errors.Is(err, os.ErrNotExist) {
+		return owned, errors.Join(errs...)
+	}
+	if err != nil {
+		return owned, errors.Join(append(errs, err)...)
+	}
+	for _, entry := range entries {
+		if !strings.HasPrefix(entry.Name(), "cni-") {
+			continue
+		}
+		info, err := os.Stat(filepath.Join(netnsDir, entry.Name()))
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		for _, ns := range namespaces {
+			if os.SameFile(ns, info) {
+				owned[entry.Name()] = true
+				break
+			}
+		}
 	}
+	return owned, errors.Join(errs...)
 }
