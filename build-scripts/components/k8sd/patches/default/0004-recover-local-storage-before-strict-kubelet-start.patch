+package storage
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+)
+
+type storageRuntime struct {
+	runtimeapi.RuntimeServiceClient
+	sandboxes                   []*runtimeapi.PodSandbox
+	calls                       []string
+	listErr, stopErr, removeErr error
+}
+
+func (r *storageRuntime) ListPodSandbox(context.Context, *runtimeapi.ListPodSandboxRequest, ...grpc.CallOption) (*runtimeapi.ListPodSandboxResponse, error) {
+	return &runtimeapi.ListPodSandboxResponse{Items: r.sandboxes}, r.listErr
+}
+func (r *storageRuntime) StopPodSandbox(_ context.Context, req *runtimeapi.StopPodSandboxRequest, _ ...grpc.CallOption) (*runtimeapi.StopPodSandboxResponse, error) {
+	r.calls = append(r.calls, "stop:"+req.PodSandboxId)
+	return &runtimeapi.StopPodSandboxResponse{}, r.stopErr
+}
+func (r *storageRuntime) RemovePodSandbox(_ context.Context, req *runtimeapi.RemovePodSandboxRequest, _ ...grpc.CallOption) (*runtimeapi.RemovePodSandboxResponse, error) {
+	r.calls = append(r.calls, "remove:"+req.PodSandboxId)
+	return &runtimeapi.RemovePodSandboxResponse{}, r.removeErr
+}
+
+func localStorageSandbox() *runtimeapi.PodSandbox {
+	return &runtimeapi.PodSandbox{
+		Id:       "storage-id",
+		Metadata: &runtimeapi.PodSandboxMetadata{Name: "ck-storage-rawfile-csi-node-abcde", Namespace: "kube-system", Uid: "storage-uid"},
+		Labels:   map[string]string{"app.kubernetes.io/name": "rawfile-csi", "app.kubernetes.io/instance": "ck-storage", "component": "node", "io.kubernetes.pod.name": "ck-storage-rawfile-csi-node-abcde", "io.kubernetes.pod.namespace": "kube-system", "io.kubernetes.pod.uid": "storage-uid"},
+	}
+}
+
+func TestRefreshLocalStorageSelectsOnlyManagedNodeSandboxes(t *testing.T) {
+	for _, change := range []struct {
+		name  string
+		alter func(*runtimeapi.PodSandbox)
+	}{
+		{"namespace", func(p *runtimeapi.PodSandbox) { p.Metadata.Namespace = "apps" }},
+		{"name", func(p *runtimeapi.PodSandbox) { p.Metadata.Name = "application" }},
+		{"release", func(p *runtimeapi.PodSandbox) { p.Labels["app.kubernetes.io/instance"] = "other" }},
+		{"component", func(p *runtimeapi.PodSandbox) { p.Labels["component"] = "controller" }},
+		{"uid", func(p *runtimeapi.PodSandbox) { p.Labels["io.kubernetes.pod.uid"] = "other" }},
+		{"labels", func(p *runtimeapi.PodSandbox) { p.Labels = nil }},
+		{"metadata", func(p *runtimeapi.PodSandbox) { p.Metadata = nil }},
+	} {
+		t.Run(change.name, func(t *testing.T) {
+			foreign := localStorageSandbox()
+			change.alter(foreign)
+			r := &storageRuntime{sandboxes: []*runtimeapi.PodSandbox{foreign, localStorageSandbox()}}
+			if err := restartSandboxes(context.Background(), r); err != nil {
+				t.Fatal(err)
+			}
+			if want := []string{"stop:storage-id", "remove:storage-id"}; !reflect.DeepEqual(r.calls, want) {
+				t.Fatalf("got %v, want %v", r.calls, want)
+			}
+		})
+	}
+}
+
+func TestRefreshLocalStorageErrorsAndRetry(t *testing.T) {
+	for _, stage := range []string{"list", "stop", "remove"} {
+		t.Run(stage, func(t *testing.T) {
+			failure := errors.New("runtime unavailable")
+			r := &storageRuntime{sandboxes: []*runtimeapi.PodSandbox{localStorageSandbox()}}
+			switch stage {
+			case "list":
+				r.listErr = failure
+			case "stop":
+				r.stopErr = failure
+			case "remove":
+				r.removeErr = failure
+			}
+			if err := restartSandboxes(context.Background(), r); !errors.Is(err, failure) {
+				t.Fatalf("got %v", err)
+			}
+			if stage == "stop" && !reflect.DeepEqual(r.calls, []string{"stop:storage-id"}) {
+				t.Fatalf("removed sandbox after failed stop: %v", r.calls)
+			}
+			r.listErr = nil
+			r.stopErr = nil
+			r.removeErr = nil
+			r.calls = nil
+			if err := restartSandboxes(context.Background(), r); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(r.calls, []string{"stop:storage-id", "remove:storage-id"}) {
+				t.Fatal(r.calls)
+			}
+		})
+	}
+}
+
+func TestRefreshLocalStorageAlreadyGone(t *testing.T) {
+	for _, stage := range []string{"stop", "remove"} {
+		t.Run(stage, func(t *testing.T) {
+			r := &storageRuntime{sandboxes: []*runtimeapi.PodSandbox{localStorageSandbox()}}
+			if stage == "stop" {
+				r.stopErr = status.Error(codes.NotFound, "gone")
+			} else {
+				r.removeErr = status.Error(codes.NotFound, "gone")
+			}
+			if err := restartSandboxes(context.Background(), r); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestRefreshLocalStorageEmpty(t *testing.T) {
+	r := &storageRuntime{}
+	if err := restartSandboxes(context.Background(), r); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.calls) != 0 {
+		t.Fatal(r.calls)
+	}
+}
+
+func TestRefreshLocalStorageCanceled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := Restart(ctx, "/tmp/no-storage-runtime.sock"); err == nil {
+		t.Fatal("canceled runtime request succeeded")
+	}
+}
