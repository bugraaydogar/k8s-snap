+// Package storage recovers node-local CSI mount propagation after a snap refresh.
+package storage
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/status"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+)
+
+// Restart removes only the local managed rawfile CSI node sandboxes. Kubelet
+// must be stopped while this runs; it recreates the sandboxes in the current
+// mount namespace when it starts. Application sandboxes and volumes are kept.
+// The caller must supply a bounded context and retain its retry marker on error.
+func Restart(ctx context.Context, socket string) error {
+	if !filepath.IsAbs(socket) {
+		return fmt.Errorf("containerd socket must be an absolute path")
+	}
+	conn, err := grpc.NewClient("unix://"+socket, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		return fmt.Errorf("failed to create local runtime client: %w", err)
+	}
+	defer conn.Close()
+	return restartSandboxes(ctx, runtimeapi.NewRuntimeServiceClient(conn))
+}
+
+func restartSandboxes(ctx context.Context, runtime runtimeapi.RuntimeServiceClient) error {
+	response, err := runtime.ListPodSandbox(ctx, &runtimeapi.ListPodSandboxRequest{}, grpc.WaitForReady(true))
+	if err != nil {
+		return fmt.Errorf("failed to list storage sandboxes: %w", err)
+	}
+	for _, sandbox := range response.Items {
+		if !managedNodeSandbox(sandbox) {
+			continue
+		}
+		if sandbox.Id == "" {
+			return fmt.Errorf("managed storage sandbox has no runtime ID")
+		}
+		if _, err := runtime.StopPodSandbox(ctx, &runtimeapi.StopPodSandboxRequest{PodSandboxId: sandbox.Id}, grpc.WaitForReady(true)); err != nil {
+			if status.Code(err) == codes.NotFound {
+				continue
+			}
+			return fmt.Errorf("failed to stop storage sandbox %s: %w", sandbox.Metadata.Name, err)
+		}
+		if _, err := runtime.RemovePodSandbox(ctx, &runtimeapi.RemovePodSandboxRequest{PodSandboxId: sandbox.Id}, grpc.WaitForReady(true)); err != nil && status.Code(err) != codes.NotFound {
+			return fmt.Errorf("failed to remove storage sandbox %s: %w", sandbox.Metadata.Name, err)
+		}
+	}
+	return nil
+}
+
+func managedNodeSandbox(sandbox *runtimeapi.PodSandbox) bool {
+	metadata := sandbox.GetMetadata()
+	if metadata == nil || metadata.Namespace != "kube-system" || metadata.Uid == "" ||
+		!strings.HasPrefix(metadata.Name, "ck-storage-rawfile-csi-node-") {
+		return false
+	}
+	labels := sandbox.GetLabels()
+	return labels["app.kubernetes.io/name"] == "rawfile-csi" &&
+		labels["app.kubernetes.io/instance"] == "ck-storage" && labels["component"] == "node" &&
+		labels["io.kubernetes.pod.name"] == metadata.Name &&
+		labels["io.kubernetes.pod.namespace"] == metadata.Namespace &&
+		labels["io.kubernetes.pod.uid"] == metadata.Uid
+}
